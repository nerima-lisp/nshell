diff --git a/native/spawn.c b/native/spawn.c
--- a/native/spawn.c
+++ b/native/spawn.c
@@ -321,7 +321,15 @@ int main(int argc, char **argv)
     for (item = 0; item < limit_count; item++) {
         if (setrlimit(limits[item].resource, &limits[item].value) < 0)
             fail(CPK_SPAWN_PHASE_RESOURCE_LIMIT);
     }
+    {
+        struct sigaction action;
+        memset(&action, 0, sizeof(action));
+        action.sa_handler = SIG_DFL;
+        if (sigemptyset(&action.sa_mask) < 0 ||
+            sigaction(SIGPIPE, &action, NULL) < 0)
+            fail(CPK_SPAWN_PHASE_SIGNAL);
+    }
     execv(argv[index], &argv[index]);
     fail(CPK_SPAWN_PHASE_EXEC);
 }
diff --git a/native/spawn.h b/native/spawn.h
--- a/native/spawn.h
+++ b/native/spawn.h
@@ -12,4 +12,5 @@ enum cpk_spawn_phase {
     CPK_SPAWN_PHASE_CREDENTIALS = 6,
     CPK_SPAWN_PHASE_RESOURCE_LIMIT = 7,
-    CPK_SPAWN_PHASE_EXEC = 8
+    CPK_SPAWN_PHASE_EXEC = 8,
+    CPK_SPAWN_PHASE_SIGNAL = 9
 };
