 (describe "run timeout and signal escalation"
+  (it "confirms group termination after reaping a timed-out leader"
+    (let ((waits nil))
+      (with-process (process (spawn "/bin/sh" (list "-c" "sleep 5")
+                                    :output :stream :error :stream))
+        (with-mocked-functions
+            (((symbol-function 'process-kit::%wait-until-process-group-gone)
+              (lambda (owned-process timeout)
+                (push (list owned-process timeout) waits)
+                t)))
+          (expect (communicate process :timeout 0.05 :grace-period 0.05
+                                       :on-timeout :return)
+                  :to-have-timed-out))
+        (expect (length waits) :to-be 1)
+        (expect (caar waits) :to-be process)
+        (expect (cadar waits) :to-be 0.05))))
+
+  (it "reports incomplete group cleanup instead of caching a timeout result"
+    (let ((waits 0)
+          (failure nil))
+      (with-process (process (spawn "/bin/sh" (list "-c" "sleep 5")
+                                    :output :stream :error :stream))
+        (with-mocked-functions
+            (((symbol-function 'process-kit::%wait-until-process-group-gone)
+              (lambda (owned-process timeout)
+                (declare (ignore owned-process timeout))
+                (incf waits)
+                nil)))
+          (handler-case
+              (communicate process :timeout 0.05 :grace-period 0.05 :on-timeout :return)
+            (process-io-error (condition) (setf failure condition))))
+        (expect waits :to-be 1)
+        (expect (typep failure 'process-io-error) :to-be-truthy)
+        (expect (process-io-error-stream failure) :to-be :cleanup)
+        (process-kit::with-locked-process-state (state process)
+          (expect (process-kit::%process-state-communication-result state) :to-be nil))
+        (dolist (retry (list (lambda ()
+                              (communicate process :timeout 0.05 :grace-period 0.05
+                                                   :on-timeout :return))
+                            (lambda ()
+                              (process-kit::%reserve-communication process nil :retry))))
+          (let ((observed nil))
+            (expect (handler-case
+                        (handler-bind
+                            ((process-io-error
+                               (lambda (condition)
+                                 (process-kit::with-locked-process-state (state process)
+                                   (expect (process-kit::%process-state-communication-result state)
+                                           :to-be nil))
+                                 (setf observed condition))))
+                          (funcall retry))
+                      (process-io-error (condition) condition))
+                    :to-be failure)
+            (expect observed :to-be failure)))
+        (process-kit::with-locked-process-state (state process)
+          (expect (process-kit::%process-state-communication-result state) :to-be nil)))))
+
   (it "run with on-timeout :return sets timed-out-p on a real timeout"
     (let ((result (run "/bin/sh" (list "-c" "sleep 5")
                        :timeout 0.2 :grace-period 0.1 :on-timeout :return)))
