(in-package #:nshell.application)

(define-condition command-argument-type-error (error)
  ((value :initarg :value :reader command-argument-type-error-value)
   (source-span :initarg :source-span
                :reader command-argument-type-error-source-span)))

(defun argv-scalar-string (value &key source-span)
  (declare (ignore value source-span))
  (%signal-unimplemented-wp-interface "L06" 'argv-scalar-string))
(define-condition value-conversion-error (error)
  ((operation :initarg :operation :reader value-conversion-error-operation)
   (input :initarg :input :reader value-conversion-error-input)
   (cause :initarg :cause :reader value-conversion-error-cause)))
(in-package #:nshell.user)
(declaim
 (ftype (function (t) string) to-json)
 (ftype (function (string) t) from-json)
 (ftype (function (list) string) to-tsv)
 (ftype (function (string) list) from-tsv)
 (ftype (function (string) list) to-lines)
 (ftype (function (list) string) from-lines)
 (ftype (function (string string) boolean) regex-match-p)
 (ftype (function (string string &key (start integer))
                 (values (or null string) (or null integer)
                         (or null integer) list))
        regex-find)
 (ftype (function (string string string &key (all-p boolean)) string)
        regex-replace)
 (ftype (function (string string &key (omit-empty-p boolean)) list)
        split-string)
 (ftype (function (list string) string) join-strings)
 (ftype (function (string string string &key (all-p boolean)) string)
        replace-string))
(defun to-json (value)
  (declare (ignore value))
  (nshell.application::%signal-unimplemented-wp-interface "L06" 'to-json))
(defun from-json (text)
  (declare (ignore text))
  (nshell.application::%signal-unimplemented-wp-interface "L06" 'from-json))
(defun to-tsv (rows)
  (declare (ignore rows))
  (nshell.application::%signal-unimplemented-wp-interface "L06" 'to-tsv))
(defun from-tsv (text)
  (declare (ignore text))
  (nshell.application::%signal-unimplemented-wp-interface "L06" 'from-tsv))
(defun to-lines (text)
  (declare (ignore text))
  (nshell.application::%signal-unimplemented-wp-interface "L06" 'to-lines))
(defun from-lines (lines)
  (declare (ignore lines))
  (nshell.application::%signal-unimplemented-wp-interface "L06" 'from-lines))
(defun regex-match-p (pattern text)
  (declare (ignore pattern text))
  (nshell.application::%signal-unimplemented-wp-interface "L06" 'regex-match-p))
(defun regex-find (pattern text &key start)
  (declare (ignore pattern text start))
  (nshell.application::%signal-unimplemented-wp-interface "L06" 'regex-find))
(defun regex-replace (pattern replacement text &key all-p)
  (declare (ignore pattern replacement text all-p))
  (nshell.application::%signal-unimplemented-wp-interface "L06" 'regex-replace))
(defun split-string (text separator &key omit-empty-p)
  (declare (ignore text separator omit-empty-p))
  (nshell.application::%signal-unimplemented-wp-interface "L06" 'split-string))
(defun join-strings (strings separator)
  (declare (ignore strings separator))
  (nshell.application::%signal-unimplemented-wp-interface "L06" 'join-strings))
(defun replace-string (text needle replacement &key all-p)
  (declare (ignore text needle replacement all-p))
  (nshell.application::%signal-unimplemented-wp-interface "L06" 'replace-string))
