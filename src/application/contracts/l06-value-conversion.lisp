(in-package #:nshell.application)

(define-condition command-argument-type-error (error)
  ((value :initarg :value :reader command-argument-type-error-value)
   (source-span :initarg :source-span
                :reader command-argument-type-error-source-span)))
(define-condition value-conversion-error (error)
  ((operation :initarg :operation :reader value-conversion-error-operation)
   (input :initarg :input :reader value-conversion-error-input)
   (cause :initarg :cause :reader value-conversion-error-cause)))
(in-package #:nshell.user)
(declaim
 (ftype (function (t) string) |to-json|)
 (ftype (function (string) t) |from-json|)
 (ftype (function (list) string) |to-tsv|)
 (ftype (function (string) list) |from-tsv|)
 (ftype (function (string) list) |to-lines|)
 (ftype (function (list) string) |from-lines|)
 (ftype (function (string string) boolean) |regex-match-p|)
 (ftype (function (string string &key (:start integer))
                 (values (or null string) (or null integer)
                         (or null integer) list))
        |regex-find|)
 (ftype (function (string string string &key (:all-p boolean)) string)
        |regex-replace|)
 (ftype (function (string string &key (:omit-empty-p boolean)) list)
        |split-string|)
 (ftype (function (list string) string) |join-strings|)
 (ftype (function (string string string &key (:all-p boolean)) string)
        |replace-string|))
