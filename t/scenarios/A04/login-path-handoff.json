{
  "id": "A04-A05-login-path-handoff",
  "uc": ["A04", "A05"],
  "mode": "batch",
  "environment": {
    "variables": {
      "PATH": "/r04-login-path-seed",
      "TERM": "dumb"
    },
    "home": "home",
    "cwd": "work"
  },
  "preconditions": {
    "files": [
      {
        "path": "home/.profile",
        "content": "PATH=/r04-login-profile:$PATH\nexport PATH\n"
      }
    ]
  },
  "invocation": {
    "kind": "argv",
    "arguments": [
      "-l",
      "-c",
      "case \":$PATH:\" in *:/r04-login-profile:*) ;; *) exit 89 ;; esac; if [ -r /etc/profile ] && [ -d /usr/bin ]; then case \":$PATH:\" in *:/usr/bin:*) ;; *) exit 90 ;; esac; fi; printf 'LOGIN_PATH_OK\\n'"
    ]
  },
  "expected": {
    "stdout": {
      "equals": "LOGIN_PATH_OK\n"
    },
    "stderr": {
      "equals": ""
    },
    "exit_code": 0
  }
}
