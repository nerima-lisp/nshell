{
  "id": "A04-A05-login-path-handoff",
  "uc": ["A04", "A05"],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/r04-login-path-seed",
      "TERM": "dumb",
      "NSHELL_PROMPT": "A04-A05-login-path-handoff> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "home/.profile",
        "content": "PATH=/r04-login-profile:$PATH\nexport PATH\n"
      }
    ]
  },
  "load_config": true,
  "wait_for_prompt": false,
  "arguments": [
    "-l",
    "-c",
      "command -v env >/dev/null || exit 90; case \":$PATH:\" in *:/r04-login-profile:*) ;; *) exit 89 ;; esac; printf 'LOGIN_PATH_OK\\n'"
  ],
  "steps": [
    {
      "type": "wait_exit"
    }
  ],
  "expected": {
    "stream": {
      "equals": "LOGIN_PATH_OK\r\n"
    },
    "exit_code": 0
  }
}
