{
  "id": "A06-login-environment",
  "uc": ["A06"],
  "mode": "batch",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "dumb",
      "USER": "r04-user",
      "SHELL": "/r04-login-shell",
      "SHLVL": "40"
    },
    "home": "home",
    "cwd": "work"
  },
  "preconditions": {
    "files": []
  },
  "invocation": {
    "kind": "argv",
    "arguments": [
      "-l",
      "-c",
      "if [ \"$SHLVL\" -eq 41 ] && [ \"$USER\" = \"r04-user\" ] && [ \"$SHELL\" = \"/r04-login-shell\" ]; then printf 'A06_OK|%s|%s|%s\\n' \"$USER\" \"$SHELL\" \"$SHLVL\"; else exit 91; fi"
    ]
  },
  "expected": {
    "stdout": {
      "contains": ["A06_OK|r04-user|/r04-login-shell|"]
    },
    "stderr": {
      "equals": ""
    },
    "exit_code": 0
  }
}
