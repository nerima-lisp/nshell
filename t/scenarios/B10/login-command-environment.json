{
  "id": "B10-login-command-environment",
  "uc": ["B10"],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "dumb",
      "NSHELL_PROMPT": "B10-login-command-environment> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "home/.config/nshell/init.lisp",
        "content": "echo R04_CONFIG_OUTPUT_LEAK\nexport PATH=/r04-config-path:$HOME/bin:$PATH\n"
      },
      {
        "path": "home/bin/env",
        "content": "#!/bin/sh\ncase \":$PATH:\" in *:/r04-config-path:*) printf 'B10_PATH_OK\\n' ;; *) exit 91 ;; esac\n",
        "executable": true
      }
    ]
  },
  "load_config": true,
  "wait_for_prompt": false,
  "arguments": ["-ilc", "env"],
  "steps": [
    {
      "type": "wait_exit"
    }
  ],
  "expected": {
    "stream": {
      "equals": "B10_PATH_OK\r\n"
    },
    "exit_code": 0
  }
}
