{
  "id": "B10-login-command-environment",
  "uc": ["B10"],
  "mode": "batch",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "dumb",
      "NSHELL_PROMPT": "R04_INIT_PROMPT_LEAK"
    },
    "home": "home",
    "cwd": "work"
  },
  "preconditions": {
    "files": [
      {
        "path": "home/.nshellrc",
        "content": "export PATH=/r04-config-path:$PATH\n"
      }
    ]
  },
  "invocation": {
    "kind": "argv",
    "arguments": ["-ilc", "env"]
  },
  "expected": {
    "stdout": {
      "contains": ["PATH=/r04-config-path"],
      "excludes": ["R04_INIT_PROMPT_LEAK", "nshell:"]
    },
    "stderr": {
      "equals": ""
    },
    "exit_code": 0
  },
  "expected_failure": {
    "reason": "The -ilc path does not yet load .nshellrc environment before handing env to /bin/sh."
  }
}
