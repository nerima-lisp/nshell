{
  "id": "B10-login-command-environment",
  "uc": ["B10"],
  "mode": "batch",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "dumb"
    },
    "home": "home",
    "cwd": "work"
  },
  "preconditions": {
    "files": [
      {
        "path": "home/.nshellrc",
        "content": "echo R04_CONFIG_OUTPUT_LEAK\nexport PATH=/r04-config-path:$PATH\n"
      }
    ]
  },
  "invocation": {
    "kind": "argv",
    "arguments": ["-ilc", "env"]
  },
  "expected": {
    "stdout": {
      "contains": ["PATH=/r04-config-path"],
      "excludes": ["R04_CONFIG_OUTPUT_LEAK", "nshell:"]
    },
    "stderr": {
      "equals": ""
    },
    "exit_code": 0
  }
}
