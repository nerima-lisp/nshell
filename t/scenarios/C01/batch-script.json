    "kind": "script",
    "path": "scenario.ns",
    "text": "echo SCENARIO_SCRIPT_OK\n"
  },
  "expected": {
    "stdout": {
      "contains": ["SCENARIO_SCRIPT_OK"]
    },
    "stderr": {
      "equals": ""
    },
    "exit_code": 0
  }
}
