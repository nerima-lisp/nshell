{
  "id": "C01-batch-script",
  "uc": ["C01"],
  "mode": "batch",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "dumb"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
