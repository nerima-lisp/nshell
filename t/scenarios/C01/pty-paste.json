{
  "id": "C01-pty-paste",
  "uc": ["C01"],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "work/answer.txt",
        "content": "SCENARIO_PTY_PASTE_OK\n"
      }
    ]
  },
  "steps": [
    {
      "type": "paste",
      "text": "cat answer.txt"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "SCENARIO_PTY_PASTE_OK",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": ["SCENARIO_PTY_PASTE_OK"]
    },
    "screen": {
      "contains": ["SCENARIO_PTY_PASTE_OK"]
    },
    "exit_code": 0
  }
}
