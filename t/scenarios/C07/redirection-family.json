{
  "id": "C07-redirection-family",
  "uc": [
    "C07"
  ],
  "mode": "batch",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "dumb",
      "NSHELL_READER": "sexp"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "expected": {
    "stdout": {
      "contains": [
        "C07_OVERWRITE",
        "C07_APPEND",
        "C07_MERGED",
        "C07_PIPE_ERR"
      ]
    },
    "stderr": {
      "equals": ""
    },
    "exit_code": 0,
    "side_effects": {
      "files": [
        {
          "path": "redirected.txt",
          "contains": [
            "C07_OVERWRITE",
            "C07_APPEND"
          ]
        },
        {
          "path": "dup.txt",
          "contains": [
            "C07_DUP"
          ]
        },
        {
          "path": "force.txt",
          "contains": [
            "C07_FORCE"
          ]
        },
        {
          "path": "both.txt",
          "contains": [
            "C07_BOTH"
          ]
        },
        {
          "path": "err.txt",
          "exists": true
        }
      ]
    }
  },
  "invocation": {
    "kind": "script",
    "path": "scenario.nsh",
    "text": "printf 'C07_OVERWRITE\\n' > redirected.txt; printf 'C07_APPEND\\n' >> redirected.txt; cat < redirected.txt; printf 'C07_DUP\\n' 3>dup.txt 1>&3; printf 'C07_FORCE\\n' >| force.txt; printf 'C07_BOTH\\n' &> both.txt; printf 'C07_ERR\\n' 2>err.txt; printf 'C07_MERGED\\n' >&2 2>&1; printf 'C07_PIPE_ERR\\n' >&2 |& cat"
  }
}
