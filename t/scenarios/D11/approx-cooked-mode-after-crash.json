{
  "id": "D11-approx-cooked-mode-after-crash",
  "uc": [
    "D11"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "D11-approx-cooked-mode-after-crash> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "work/crash-terminal.sh",
        "content": "#!/bin/sh\nstty raw -echo\nkill -KILL $$\n"
      },
      {
        "path": "work/after-crash.txt",
        "content": "D11_COOKED_READY\n"
      }
    ]
  },
  "expected": {
    "stream": {
      "contains": [
        "D11_COOKED_READY",
        "D11_CANON_OK",
        "D11_ISIG_OK",
        "D11_ECHO_OK",
        "D11_CHECK_DONE"
      ]
    },
    "exit_code": 0
  },
  "steps": [
    {
      "type": "keys",
      "text": "sh crash-terminal.sh"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": "cat after-crash.txt"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "D11_COOKED_READY",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "sh -c 'stty -a | grep -Eq \"(^|[[:space:];])icanon([[:space:];]|$)\" && printf \"%s%s\" D11_CANON_ OK; stty -a | grep -Eq \"(^|[[:space:];])isig([[:space:];]|$)\" && printf \"%s%s\" D11_ISIG_ OK; stty -a | grep -Eq \"(^|[[:space:];])echo([[:space:];]|$)\" && printf \"%s%s\" D11_ECHO_ OK; printf \"%s%s\" D11_CHECK_ DONE'"
    },
    {
      "type": "wait_input",
      "contains": "D11_CHECK_ DONE",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "D11_CHECK_DONE",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ]
}
