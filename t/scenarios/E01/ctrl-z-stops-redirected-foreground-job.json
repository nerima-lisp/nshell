{
  "id": "E01-ctrl-z-stops-redirected-foreground-job",
  "uc": [
    "E01"
  ],
  "mode": "pty",
  "input_delay_seconds": 0.1,
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "E01-ctrl-z-stops-redirected-foreground-job> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "work/job.sh",
        "content": "printf E01_STARTED_$((1+2)) > /dev/tty\nsleep 5\n"
      }
    ]
  },
  "expected": {
    "stream": {
      "contains": [
          "E01_STARTED_3",
          "E01_CAPTURED_5"
      ]
    },
      "exit_code": 0,
      "side_effects": {
        "files": [
          {
            "path": "stopped.out",
            "exists": true
          },
          {
            "path": "stopped-jobs.txt",
            "contains": [
              "Stopped",
              "sh job.sh"
            ]
          }
        ]
      }
  },
  "steps": [
    {
      "type": "keys",
      "text": "sh job.sh > stopped.out"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "E01_STARTED_3",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "C-z"
    },
    {
      "type": "keys",
      "text": "jobs > stopped-jobs.txt; echo E01_CAPTURED_$((2+3))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "E01_CAPTURED_5",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "kill %1; wait %1"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": "echo E01_AFTER_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "E01_AFTER_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ]
}
