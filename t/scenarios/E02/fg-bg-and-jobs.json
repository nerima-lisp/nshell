{
  "id": "E02-fg-bg-and-jobs",
  "uc": [
    "E02"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "E02-fg-bg-and-jobs> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "expected": {
    "stream": {
      "contains": [
        "E02_STARTED_2",
        "E02_STOPPED_JOBS_3",
        "E02_BG_JOBS_4",
        "E02_FG_RETURNED_5"
      ]
    },
    "exit_code": 0,
    "side_effects": {
      "files": [
        {
          "path": "e02-stopped.txt",
          "contains": [
            "Stopped",
            "sleep 5"
          ]
        },
        {
          "path": "e02-running.txt",
          "contains": [
            "Running",
            "sleep 5"
          ]
        },
        {
          "path": "e02-child.txt",
          "equals": "E02_CHILD_DONE"
        },
        {
          "path": "e02-final-jobs.txt",
          "equals": ""
        }
      ]
    }
  },
  "steps": [
    {
      "type": "keys",
      "text": "sh -c 'printf E02_STARTED_$((1+1)); sleep 5; printf E02_CHILD_DONE > e02-child.txt'"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "E02_STARTED_2",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "C-z"
    },
    {
      "type": "keys",
      "text": "jobs > e02-stopped.txt; echo E02_STOPPED_JOBS_$((1+2))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "E02_STOPPED_JOBS_3",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "bg %1; jobs > e02-running.txt; echo E02_BG_JOBS_$((2+2))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "E02_BG_JOBS_4",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "fg %1; cat e02-child.txt; jobs > e02-final-jobs.txt; echo E02_FG_RETURNED_$((2+3))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "E02_FG_RETURNED_5",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ]
}
