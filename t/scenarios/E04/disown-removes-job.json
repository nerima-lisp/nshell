{
  "id": "E04-disown-removes-job",
  "uc": [
    "E04"
  ],
  "mode": "batch",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "dumb"
    },
    "home": "home",
