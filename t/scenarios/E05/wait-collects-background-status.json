{
  "id": "E05-wait-collects-background-status",
  "uc": [
    "E05"
  ],
  "mode": "batch",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "dumb"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "expected": {
    "stdout": {
      "contains": [
        "E05_CHILD_DONE"
      ]
    },
    "exit_code": 0,
    "side_effects": {
      "files": [
        {
          "path": "e05-child.txt",
          "equals": "E05_CHILD_DONE"
        },
        {
          "path": "e05-jobs.txt",
          "exists": true,
          "equals": ""
        }
      ]
    }
  },
  "invocation": {
    "kind": "command",
    "text": "sh -c 'sleep 2; printf E05_CHILD_DONE > e05-child.txt; exit 7' & wait %1; test $? -eq 7 && cat e05-child.txt && jobs > e05-jobs.txt"
  }
}
