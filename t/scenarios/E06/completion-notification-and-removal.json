{
  "id": "E06-completion-notification-and-removal",
  "uc": [
    "E06"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "E06-completion-notification-and-removal> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "expected": {
    "stream": {
      "contains": [
        "Done"
      ]
    },
    "exit_code": 0,
    "side_effects": {
      "files": [
        {
          "path": "completed-jobs.txt",
          "exists": true,
          "equals": ""
        }
      ]
    }
  },
  "steps": [
    {
      "type": "keys",
      "text": "sleep 0.1 &"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": "wait; jobs > completed-jobs.txt; echo E06_$((2+4))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "E06_6",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected_failure": {
    "reason": "WP-R03 owns completion notification and removal of completed jobs."
  }
}
