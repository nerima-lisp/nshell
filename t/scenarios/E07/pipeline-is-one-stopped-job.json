{
  "id": "E07-pipeline-is-one-stopped-job",
  "uc": [
    "E07"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "E07-pipeline-is-one-stopped-job> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "expected": {
    "stream": {
      "contains": [
        "Stopped"
      ]
    },
    "exit_code": 0
  },
  "steps": [
    {
      "type": "keys",
      "text": "sleep 0.5 | cat"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "key",
      "key": "C-z"
    },
    {
      "type": "keys",
      "text": "jobs"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": "kill %1"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "key",
      "key": "C-c"
    },
    {
      "type": "keys",
      "text": "echo E07_AFTER_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "E07_AFTER_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected_failure": {
    "reason": "WP-R03 owns Ctrl-Z and stopped-job reporting for foreground commands."
  }
}
