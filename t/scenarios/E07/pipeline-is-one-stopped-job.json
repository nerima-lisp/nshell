{
  "id": "E07-pipeline-is-one-stopped-job",
  "uc": [
    "E07"
  ],
  "mode": "pty",
  "input_delay_seconds": 0.12,
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "E07-pipeline-is-one-stopped-job> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "expected": {
    "stream": {
      "contains": [
          "E07_STARTED_5",
          "E07_JOBS_CAPTURED_7",
          "E07_AFTER_2"
      ]
    },
      "exit_code": 0,
      "side_effects": {
        "files": [
          {
            "path": "stopped-pipeline-jobs.txt",
            "contains": [
              "Stopped",
              "| cat"
            ]
          },
          {
            "path": "stopped-pipeline-count.txt",
            "equals": "1\n"
          }
        ]
      }
  },
  "steps": [
    {
      "type": "keys",
      "text": "sh -c 'printf E07_STARTED_$((2+3)); sleep 5' | cat"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "E07_STARTED_5",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "C-z"
    },
    {
      "type": "keys",
      "text": "jobs > stopped-pipeline-jobs.txt; grep -c Stopped stopped-pipeline-jobs.txt > stopped-pipeline-count.txt; kill %1; wait %1; echo E07_JOBS_CAPTURED_$((3+4))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "E07_JOBS_CAPTURED_7",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "echo E07_AFTER_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "E07_AFTER_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ]
}
