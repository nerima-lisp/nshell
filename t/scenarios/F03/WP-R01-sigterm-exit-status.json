{
  "id": "F03-wp-r01-sigterm-exit-status",
  "uc": ["F03"],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "R01> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 100,
      "rows": 30
    }
  },
  "preconditions": {
    "files": []
  },
  "steps": [
    {
      "type": "keys",
      "text": "sh -c 'printf \"%s%s\" F03_TERM_ READY; sleep 2; kill -TERM \"$PPID\"; sleep 2'"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "F03_TERM_READY",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "exit_code": 143
  }
}
