{
  "id": "F06-approx-osc-7-cwd",
  "uc": [
    "F06"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "F06-approx-osc-7-cwd> "
    },
    "home": "home",
    "cwd": "work/日本 語",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "work/日本 語/marker.txt",
        "content": "F06_READY\n"
      },
      {
        "path": "work/更新/.keep",
        "content": ""
      }
    ]
  },
  "expected": {
    "stream": {
      "contains": [
        "F06_READY"
      ],
      "ordered_contains": [
        "\u001b]7;file://",
        "%E6%97%A5%E6%9C%AC%20%E8%AA%9E",
        "F06_READY",
        "\u001b]7;file://",
        "%E6%9B%B4%E6%96%B0"
      ]
    },
    "exit_code": 0
  },
  "steps": [
    {
      "type": "keys",
      "text": "cat marker.txt && cd ../更新"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "F06_READY",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ]
}
