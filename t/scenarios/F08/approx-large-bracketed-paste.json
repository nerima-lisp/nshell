{
  "id": "F08-large-bracketed-paste",
  "uc": [
    "F08"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "F08_DONE": "F08_PASTE_FINISHED",
      "F08_RECOVERED": "F08_CANCEL_RECOVERED",
      "NSHELL_PROMPT": "F08-large-bracketed-paste> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "expected": {
    "stream": {
      "ordered_contains": [
        "8192",
        "F08_PASTE_FINISHED",
        "F08_CANCEL_RECOVERED"
      ]
    },
    "exit_code": 0
  },
  "steps": [
    {
      "type": "keys",
      "text": "printf '%s' '"
    },
    {
      "type": "paste",
      "text": ""
    },
    {
      "type": "keys",
      "text": "' | wc -c; echo $F08_DONE"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "key",
      "key": "C-c"
    },
    {
      "type": "keys",
      "text": "echo $F08_RECOVERED"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "F08_CANCEL_RECOVERED",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "input_delay_seconds": 0.3
}
