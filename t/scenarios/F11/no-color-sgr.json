{
  "id": "F11-no-color-sgr",
  "uc": [
    "F11"
  ],
  "mode": "pty",
  "input_delay_seconds": 0.3,
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "COLORTERM": "truecolor",
      "NO_COLOR": "1",
      "NSHELL_PROMPT": "F11-no-color> ",
      "F11_MARKER": "F11_COMMAND_OK"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "steps": [
    {
      "type": "keys",
      "text": "echo \"$F11_MARKER\""
    },
    {
      "type": "wait_input",
      "contains": "echo \"$F11_MARKER\"",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "F11_COMMAND_OK",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "excludes": [
        "\u001b[1;94m",
        "\u001b[1;38;5;75m",
        "\u001b[1;38;2;95;175;255m"
      ]
    },
    "exit_code": 0
  }
}
