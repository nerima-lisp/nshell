{
  "id": "F12-approx-term-dumb-command-line",
  "uc": [
    "F12"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "dumb",
      "NSHELL_PROMPT": "F12-approx-term-dumb-command-line> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "work/dumb.txt",
        "content": "F12_DUMB_READY\n"
      }
    ]
  },
  "expected": {
    "stream": {
      "contains": [
        "F12_DUMB_READY"
      ]
    },
    "exit_code": 0
  },
  "steps": [
    {
      "type": "keys",
      "text": "cat dumb.txt"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "F12_DUMB_READY",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ]
}
