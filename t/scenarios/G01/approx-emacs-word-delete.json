{
  "id": "G01-approx-emacs-word-delete",
  "uc": [
    "G01"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "G01_WORD_DELETE> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "expected": {
    "side_effects": {
      "files": [
        {
          "path": "created",
          "exists": true
        }
      ]
    },
    "exit_code": 0
  },
  "steps": [
    {
      "type": "keys",
      "text": "touch discarded"
    },
    {
      "type": "key",
      "key": "M-b"
    },
    {
      "type": "key",
      "key": "M-d"
    },
    {
      "type": "keys",
      "text": "created; echo G01_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "G01_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ]
}
