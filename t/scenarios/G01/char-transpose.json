{
  "id": "G01-char-transpose",
  "uc": ["G01"],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "G01T> "
    },
    "home": "home",
    "cwd": "work"
  },
  "preconditions": {
    "files": [
      {
        "path": "work/checker.sh",
        "content": "case \"$1\" in\n  ab) printf '%s\\n' 'G01_CHAR_TRANSPOSE_OK' ;;\nesac\n"
      }
    ]
  },
  "steps": [
    {"type": "keys", "text": "sh checker.sh ba"},
    {"type": "key", "key": "C-t"},
    {"type": "key", "key": "Enter"},
    {"type": "wait", "contains": "G01_CHAR_TRANSPOSE_OK"},
    {"type": "keys", "text": "exit"},
    {"type": "key", "key": "Enter"},
    {"type": "wait_exit"}
  ],
  "expected": {
    "stream": {"contains": ["G01_CHAR_TRANSPOSE_OK"]},
    "exit_code": 0
  }
}
