{
  "id": "G01-word-motion-deletion",
  "uc": ["G01"],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "G01W> "
    },
    "home": "home",
    "cwd": "work"
  },
  "preconditions": {
    "files": [
      {
        "path": "work/checker.sh",
        "content": "case \"$1\" in\n  proof) printf '%s\\n' 'G01_WORD_MOTION_DELETE_OK' ;;\nesac\n"
      }
    ]
  },
  "steps": [
    {"type": "keys", "text": "sh checker.sh remove proof"},
    {"type": "key", "key": "M-b"},
    {"type": "key", "key": "M-b"},
    {"type": "key", "key": "M-d"},
    {"type": "key", "key": "Enter"},
    {"type": "wait", "contains": "G01_WORD_MOTION_DELETE_OK"},
    {"type": "keys", "text": "exit"},
    {"type": "key", "key": "Enter"},
    {"type": "wait_exit"}
  ],
  "expected": {
    "stream": {"contains": ["G01_WORD_MOTION_DELETE_OK"]},
    "exit_code": 0
  }
}
