{
  "id": "G02-goto-end",
  "uc": ["G02"],
  "mode": "pty",
  "input_delay_seconds": 0.12,
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "G02G> ",
      "NSHELL_VI_MODE": "1"
    },
    "home": "home",
    "cwd": "work"
  },
  "preconditions": {
    "files": [
      {
        "path": "work/checker.sh",
        "content": "case \"$1\" in\n  zf) printf '%s\\n' 'G02_GOTO_END_OK' ;;\nesac\nprintf '%s\\n' 'G02_COMMAND_FINISHED'\n"
      }
    ]
  },
  "steps": [
    {"type": "key", "key": "Enter"},
    {"type": "wait", "contains": "\u001b[6 q"},
    {"type": "keys", "text": "sh checker.sh z"},
    {"type": "key", "key": "Home"},
    {"type": "key", "key": "Escape"},
    {"type": "wait", "contains": "\u001b[2 q"},
    {"type": "keys", "text": "\u001bG"},
    {"type": "key", "key": "a"},
    {"type": "wait", "contains": "\u001b[6 q"},
    {"type": "keys", "text": "f"},
    {"type": "key", "key": "Escape"},
    {"type": "wait", "contains": "\u001b[2 q"},
    {"type": "key", "key": "Enter"},
    {"type": "wait", "contains": "G02_COMMAND_FINISHED"},
    {"type": "keys", "text": "exit"},
    {"type": "key", "key": "Enter"},
    {"type": "wait_exit"}
  ],
  "expected": {
    "stream": {"contains": ["G02_GOTO_END_OK"]},
    "exit_code": 0
  }
}
