{
  "id": "G02-insert-command-cursor-shape",
  "uc": ["G02"],
  "mode": "pty",
  "input_delay_seconds": 0.12,
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "G02M> ",
      "NSHELL_VI_MODE": "1"
    },
    "home": "home",
    "cwd": "work"
  },
  "preconditions": {
    "files": [
      {
        "path": "work/checker.sh",
        "content": "case \"$1\" in\n  proof) printf '%s\\n' 'G02_MODE_SWITCH_OK' ;;\nesac\n"
      }
    ]
  },
  "steps": [
    {"type": "keys", "text": "sh checker.sh proo"},
    {"type": "key", "key": "Escape"},
    {"type": "wait", "contains": "\u001b[2 q"},
    {"type": "key", "key": "a"},
    {"type": "wait", "contains": "\u001b[6 q"},
    {"type": "keys", "text": "f"},
    {"type": "key", "key": "Escape"},
    {"type": "wait", "contains": "\u001b[2 q"},
    {"type": "key", "key": "Enter"},
    {"type": "wait", "contains": "G02_MODE_SWITCH_OK"},
    {"type": "keys", "text": "exit"},
    {"type": "key", "key": "Enter"},
    {"type": "wait_exit"}
  ],
  "expected": {
    "stream": {
      "contains": ["\u001b[2 q", "\u001b[6 q", "G02_MODE_SWITCH_OK"]
    },
    "exit_code": 0
  }
}
