{
  "id": "G02-undo-find-replace-repeat",
  "uc": ["G02"],
  "mode": "pty",
  "input_delay_seconds": 0.12,
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "G02U> ",
      "NSHELL_VI_MODE": "1"
    },
    "home": "home",
    "cwd": "work"
  },
  "preconditions": {
    "files": [
      {
        "path": "work/checker.sh",
        "content": "if [ \"$1\" = proof ] && [ \"$2\" = proof ]; then printf '%s\\n' 'G02_VI_ACTIONS_OK'; fi\nprintf '%s\\n' 'G02_COMMAND_FINISHED'\n"
      }
    ]
  },
  "steps": [
    {"type": "keys", "text": "sh checker.sh prxof prxof"},
    {"type": "key", "key": "Escape"},
    {"type": "wait", "contains": "\u001b[2 q"},
    {"type": "key", "key": "0"},
    {"type": "key", "key": "w"},
    {"type": "key", "key": "w"},
    {"type": "key", "key": "f"},
    {"type": "key", "key": "x"},
    {"type": "key", "key": "r"},
    {"type": "key", "key": "o"},
    {"type": "key", "key": "w"},
    {"type": "key", "key": "f"},
    {"type": "key", "key": "x"},
    {"type": "keys", "text": "."},
    {"type": "key", "key": "u"},
    {"type": "keys", "text": "."},
    {"type": "key", "key": "Enter"},
    {"type": "wait", "contains": "G02_COMMAND_FINISHED"},
    {"type": "keys", "text": "exit"},
    {"type": "key", "key": "Enter"},
    {"type": "wait_exit"}
  ],
  "expected": {
    "stream": {"contains": ["G02_VI_ACTIONS_OK"]},
    "exit_code": 0
  }
}
