{
  "id": "G09-approx-balanced-parentheses-before-enter",
  "uc": [
    "G09"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "G09-approx-balanced-parentheses-before-enter> ",
      "G09_MESSAGE": "G09_BALANCED",
      "G09_READY": "G09_READY_MARKER"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "expected": {
    "stream": {
      "contains": [
        "G09_BALANCED"
      ]
    },
    "exit_code": 0
  },
  "steps": [
    {
      "type": "keys",
      "text": "(echo $G09_MESSAGE G09_SUB"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": ")"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "G09_BALANCED G09_SUB",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "C-c"
    },
    {
      "type": "keys",
      "text": "echo $G09_READY"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "G09_READY_MARKER",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "C-a"
    },
    {
      "type": "key",
      "key": "C-k"
    },
    {
      "type": "keys",
      "text": "(format t \"G09_AFTER_~d~%\" (+ 1 1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "G09_AFTER_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "input_delay_seconds": 0.2
}
