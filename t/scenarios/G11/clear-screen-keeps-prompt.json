{
  "id": "G11-clear-screen-keeps-prompt",
  "uc": [
    "G11"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "G11-clear-screen-keeps-prompt> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "work/before-clear.txt",
        "content": "G11_BEFORE_CLEAR\n"
      }
    ]
  },
  "expected": {
    "stream": {
      "contains": [
        "G11_BEFORE_CLEAR"
      ]
    },
    "screen": {
      "excludes": [
        "G11_BEFORE_CLEAR"
      ]
    },
    "exit_code": 0
  },
  "steps": [
    {
      "type": "keys",
      "text": "cat before-clear.txt"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "G11_BEFORE_CLEAR",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "C-l"
    },
    {
      "type": "keys",
      "text": "echo G11_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "G11_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ]
}
