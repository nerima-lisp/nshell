{
  "id": "G12-grapheme-boundary",
  "uc": ["G12"],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "G12> "
    },
    "home": "home",
    "cwd": "work"
  },
  "preconditions": {
    "files": [
      {
        "path": "work/checker.sh",
        "content": "case \"$1\" in\n  ab) printf '%s\\n' 'G12_GRAPHEME_BOUNDARY_OK' ;;\nesac\n"
      }
    ]
  },
  "steps": [
    {"type": "keys", "text": "sh checker.sh a👩‍💻b"},
    {"type": "key", "key": "C-e"},
    {"type": "key", "key": "Left"},
    {"type": "key", "key": "BSpace"},
    {"type": "key", "key": "Enter"},
    {"type": "wait", "contains": "G12_GRAPHEME_BOUNDARY_OK"},
    {"type": "keys", "text": "exit"},
    {"type": "key", "key": "Enter"},
    {"type": "wait_exit"}
  ],
  "expected": {
    "stream": {"contains": ["G12_GRAPHEME_BOUNDARY_OK"]},
    "exit_code": 0
  }
}
