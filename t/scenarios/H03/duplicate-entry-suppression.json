{
  "id": "H03-duplicate-entry-suppression",
  "uc": [
    "H03"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_H03-duplicate-entry-suppression> ",
      "SCENARIO_VALUE": "H03_DUPLICATE"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "steps": [
    {
      "type": "keys",
      "text": "echo \"$SCENARIO_VALUE\""
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "H03_DUPLICATE",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "echo \"$SCENARIO_VALUE\""
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "H03_DUPLICATE",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "history delete 'echo \"$SCENARIO_VALUE\"'"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "1",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "1"
      ]
    },
    "exit_code": 0
  }
}
