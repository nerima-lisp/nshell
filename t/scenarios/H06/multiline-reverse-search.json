{
  "id": "H06-multiline-reverse-search",
  "uc": [
    "H06"
  ],
  "mode": "pty",
  "input_delay_seconds": 0.12,
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_H06-multiline-reverse-search> ",
      "NSHELL_VI_MODE": "1"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "home/.local/share/nshell/history",
        "content": "# nshell-history-v3 139\n(:text \"echo H06_OLD_START\necho H06_NEEDLE_OLD_CONTINUATION\" :timestamp 1 :cwd \"/scenario/work\" :exit-code 0 :duration-ms 1 :origin :typed)\n# nshell-history-v3 139\n(:text \"echo H06_NEW_START\necho H06_NEEDLE_NEW_CONTINUATION\" :timestamp 2 :cwd \"/scenario/work\" :exit-code 0 :duration-ms 1 :origin :typed)\n"
      }
    ]
  },
  "steps": [
    {
      "type": "key",
      "key": "C-r"
    },
    {
      "type": "keys",
      "text": "H06_NEEDLE"
    },
    {
      "type": "wait",
      "contains": "OLD_CONTINUATION",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "C-r"
    },
    {
      "type": "wait",
      "contains": "OLD_CONTINUATION",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "C-c"
    },
    {
      "type": "wait",
      "contains": "\u001b[6 q",
      "timeout_seconds": 10
    },
    {
      "type": "paste",
      "text": "echo H06_FIRST_$((1+1))"
    },
    {
      "type": "wait",
      "contains": "\u001b[6 q",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "H06_FIRST_2",
      "timeout_seconds": 10
    },
    {
      "type": "paste",
      "text": "echo H06_SECOND_$((2+2))"
    },
    {
      "type": "wait",
      "contains": "\u001b[6 q",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "H06_SECOND_4",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "echo H06_NEW_START",
        "echo H06_OLD_START",
        "NEW_CONTINUATION",
        "OLD_CONTINUATION",
        "H06_FIRST_2",
        "H06_SECOND_4"
      ]
    },
    "exit_code": 0
  }
}
