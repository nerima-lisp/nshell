{
  "id": "H08-delete-history-entry",
  "uc": [
    "H08"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_H08-delete-history-entry> ",
      "SCENARIO_COMMAND": "echo H08_CREATED_$((1+1))",
      "SCENARIO_HISTORY_TEXT": "eval \"$SCENARIO_COMMAND\""
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "steps": [
    {
      "type": "keys",
      "text": "eval \"$SCENARIO_COMMAND\""
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "H08_CREATED_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "history delete \"$SCENARIO_HISTORY_TEXT\"; echo H08_DELETE_FINISHED_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "H08_DELETE_FINISHED_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "H08_CREATED_2",
        "H08_DELETE_FINISHED_2"
      ]
    },
    "exit_code": 0,
    "side_effects": {
      "history": {
        "path": ".local/share/nshell/history",
        "excludes": [
          "eval \\\"$SCENARIO_COMMAND\\\""
        ]
      }
    }
  }
}
