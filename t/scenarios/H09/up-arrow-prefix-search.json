{
  "id": "H09-up-arrow-prefix-search",
  "uc": [
    "H09"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_H09-up-arrow-prefix-search> ",
      "H09_RUN": "0"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "steps": [
    {
      "type": "keys",
      "text": "echo H09_PREFIX_RESULT >> prefix-results.txt; H09_RUN=$((H09_RUN+1)); echo H09_REPLAY_READY_$H09_RUN"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "H09_REPLAY_READY_1",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "echo \"H09_DECOY_$((1+1)) echo H09_PREFIX_INTERNAL\""
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "H09_DECOY_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "echo H09_PREFIX_"
    },
    {
      "type": "key",
      "key": "Up"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "H09_REPLAY_READY_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "sed -n '2p' prefix-results.txt; echo H09_REPLAY_READBACK_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "H09_REPLAY_READBACK_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "H09_REPLAY_READBACK_2"
      ]
    },
    "exit_code": 0,
    "side_effects": {
      "files": [
        {
          "path": "prefix-results.txt",
          "equals": "H09_PREFIX_RESULT\nH09_PREFIX_RESULT\n"
        }
      ]
    }
  }
}
