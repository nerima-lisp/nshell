{
  "id": "H09-up-arrow-prefix-search",
  "uc": [
    "H09"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_H09-up-arrow-prefix-search> ",
      "SCENARIO_VALUE": "H09_PREFIX_RESULT"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "steps": [
    {
      "type": "keys",
      "text": "echo $SCENARIO_VALUE"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "H09_PREFIX_RESULT",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "echo $SCENARIO_"
    },
    {
      "type": "key",
      "key": "Up"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "H09_PREFIX_RESULT",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "H09_PREFIX_RESULT"
      ]
    },
    "exit_code": 0
  }
}
