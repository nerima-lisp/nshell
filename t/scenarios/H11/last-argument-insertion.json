{
  "id": "H11-last-argument-insertion",
  "uc": [
    "H11"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_H11-last-argument-insertion> ",
      "SCENARIO_VALUE": "H11_LAST_ARGUMENT"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "steps": [
    {
      "type": "keys",
      "text": "echo \"$SCENARIO_VALUE\""
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "H11_LAST_ARGUMENT",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "echo "
    },
    {
      "type": "keys",
      "text": "\u001b."
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "H11_LAST_ARGUMENT",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "H11_LAST_ARGUMENT"
      ]
    },
    "exit_code": 0
  }
}
