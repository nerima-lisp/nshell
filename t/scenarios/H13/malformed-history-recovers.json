{
  "id": "H13-malformed-history-recovers",
  "uc": [
    "H13"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_H13-malformed-history-recovers> ",
      "SCENARIO_VALUE": "H13_RECOVERY_OK",
      "SCENARIO_BEFORE_RESULT": "H13_BEFORE_REPLAY_RESULT",
      "SCENARIO_AFTER_RESULT": "H13_AFTER_REPLAY_RESULT"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "home/.local/share/nshell/history",
        "content": "# nshell-history-v3 144\n(:text \"echo \\\"$SCENARIO_BEFORE_RESULT\\\" # H13_BEFORE_CORRUPTION\" :timestamp 1 :cwd \"/scenario/work\" :exit-code 0 :duration-ms 1 :origin :typed)\n# nshell-history-v3 15\n(:text \"broken\"\n# nshell-history-v3 142\n(:text \"echo \\\"$SCENARIO_AFTER_RESULT\\\" # H13_AFTER_CORRUPTION\" :timestamp 1 :cwd \"/scenario/work\" :exit-code 0 :duration-ms 1 :origin :typed)\n"
      }
    ]
  },
  "steps": [
    {
      "type": "key",
      "key": "C-r"
    },
    {
      "type": "keys",
      "text": "H13_BEFORE_CORRUPTION"
    },
    {
      "type": "key",
      "key": "Right"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "key",
      "key": "C-r"
    },
    {
      "type": "keys",
      "text": "H13_AFTER_CORRUPTION"
    },
    {
      "type": "key",
      "key": "Right"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": "echo \"$SCENARIO_VALUE\""
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "H13_RECOVERY_OK",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "nshell: history: unable to read",
        "H13_BEFORE_REPLAY_RESULT",
        "H13_AFTER_REPLAY_RESULT",
        "H13_RECOVERY_OK"
      ]
    },
    "exit_code": 0,
    "side_effects": {
      "history": {
        "path": ".local/share/nshell/history",
        "contains": [
          "echo \\\"$SCENARIO_BEFORE_RESULT\\\" # H13_BEFORE_CORRUPTION",
          "echo \\\"$SCENARIO_AFTER_RESULT\\\" # H13_AFTER_CORRUPTION",
          "echo \\\"$SCENARIO_VALUE\\\""
        ]
      }
    }
  }
}
