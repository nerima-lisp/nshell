{
  "id": "H13-malformed-history-recovers",
  "uc": [
    "H13"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_H13-malformed-history-recovers> ",
      "SCENARIO_VALUE": "H13_RECOVERY_OK"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "home/.local/state/nshell/history",
        "content": "# nshell-history-v3 999\n(:text \"broken\""
      }
    ]
  },
  "steps": [
    {
      "type": "keys",
      "text": "echo \"$SCENARIO_VALUE\""
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "H13_RECOVERY_OK",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "H13_RECOVERY_OK"
      ]
    },
    "exit_code": 0
  }
}
