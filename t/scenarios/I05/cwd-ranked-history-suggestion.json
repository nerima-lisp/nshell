{
  "id": "I05-cwd-ranked-history-suggestion",
  "uc": [
    "I05"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_I05-cwd-ranked-history-suggestion> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "steps": [
    {
      "type": "keys",
      "text": "mkdir -p a b; echo I05_SETUP_$((1+1))"
    },
    {
      "type": "wait_input",
      "contains": "mkdir -p a b",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "I05_SETUP_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "cd a; echo I05_SETUP_$((1+2))"
    },
    {
      "type": "wait_input",
      "contains": "cd a; echo I05_SETUP_",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "I05_SETUP_3",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "touch I05_A_FILE; echo I05_SETUP_$((1+3))"
    },
    {
      "type": "wait_input",
      "contains": "touch I05_A_FILE",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "I05_SETUP_4",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "rm I05_A_FILE; echo I05_SETUP_$((1+4))"
    },
    {
      "type": "wait_input",
      "contains": "rm I05_A_FILE",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "I05_SETUP_5",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "cd ../b; echo I05_SETUP_$((1+5))"
    },
    {
      "type": "wait_input",
      "contains": "cd ../b; echo I05_SETUP_",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "I05_SETUP_6",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "touch I05_B_FILE; echo I05_SETUP_$((1+6))"
    },
    {
      "type": "wait_input",
      "contains": "touch I05_B_FILE",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "I05_SETUP_7",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "rm I05_B_FILE; echo I05_SETUP_$((1+7))"
    },
    {
      "type": "wait_input",
      "contains": "rm I05_B_FILE",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "I05_SETUP_8",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "cd ../a; echo I05_SETUP_$((1+8))"
    },
    {
      "type": "wait_input",
      "contains": "cd ../a; echo I05_SETUP_",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "I05_SETUP_9",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "touch I05_"
    },
    {
      "type": "key",
      "key": "M-Right"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": "echo I05_AFTER_$((1+1))"
    },
    {
      "type": "wait_input",
      "contains": "echo I05_AFTER_",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "I05_AFTER_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "wait_input",
      "contains": "exit",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "side_effects": {
      "files": [
        {
          "path": "a/I05_A_FILE",
          "exists": true
        },
        {
          "path": "b/I05_B_FILE",
          "exists": false
        },
        {
          "path": "a/I05_",
          "exists": false
        }
      ]
    },
    "exit_code": 0
  }
}
