{
  "id": "I05-cwd-ranked-history-suggestion",
  "uc": [
    "I05"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_I05-cwd-ranked-history-suggestion> ",
      "SCENARIO_VALUE_A": "I05_A_CWD",
      "SCENARIO_VALUE_B": "I05_B_CWD",
      "SCENARIO_A_FILE": "I05_A_FILE",
      "SCENARIO_B_FILE": "I05_B_FILE"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "steps": [
    {
      "type": "keys",
      "text": "mkdir -p a b; echo I05_SETUP_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "I05_SETUP_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "cd a; touch $SCENARIO_A_FILE; rm $SCENARIO_A_FILE; echo I05_SETUP_$((1+2))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "I05_SETUP_3",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "cd ../b; touch $SCENARIO_B_FILE; rm $SCENARIO_B_FILE; echo I05_SETUP_$((2+2))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "I05_SETUP_4",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "cd ../a; echo I05_SETUP_$((2+3))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "I05_SETUP_5",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "touch I05_"
    },
    {
      "type": "key",
      "key": "M-Right"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": "echo I05_AFTER_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "I05_AFTER_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "side_effects": {
      "files": [
        {
          "path": "a/I05_A_FILE",
          "exists": true
        },
        {
          "path": "b/I05_B_FILE",
          "exists": false
        },
        {
          "path": "a/I05_",
          "exists": false
        }
      ]
    },
    "exit_code": 0
  },
  "expected_failure": {
    "reason": "WP-E06 owns cwd-ranked history suggestions."
  }
}
