{
  "id": "I07-suggestion-keystrokes-remain-responsive",
  "uc": [
    "I07"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_I07-suggestion-keystrokes-remain-responsive> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "home/.local/share/nshell/history",
        "content": "# nshell-history-v3 115\n(:text \"echo I07_HISTORY_SUGGESTION\" :timestamp 1 :cwd \"/scenario/work\" :exit-code 0 :duration-ms 1 :origin :typed)\n"
      }
    ]
  },
  "expected": {
    "stream": {
      "contains": [
        "I07_HISTORY_SUGGESTION",
        "I07_AFTER_2"
      ]
    },
    "exit_code": 0
  },
  "steps": [
    {
      "type": "keys",
      "text": "echo I07_HISTORY"
    },
    {
      "type": "key",
      "key": "C-a"
    },
    {
      "type": "key",
      "key": "C-e"
    },
    {
      "type": "key",
      "key": "C-c"
    },
    {
      "type": "key",
      "key": "C-c"
    },
    {
      "type": "keys",
      "text": "echo I07_AFTER_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "key",
      "key": "C-d"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ]
}
