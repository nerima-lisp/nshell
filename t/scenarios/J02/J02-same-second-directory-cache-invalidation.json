{
  "id": "J02-same-second-directory-cache-invalidation",
  "uc": ["J02", "J12"],
  "mode": "batch",
  "environment": {
    "variables": {"PATH": "/usr/bin:/bin", "TERM": "dumb"},
    "append_extra_path": true,
    "home": "home",
    "cwd": "work"
  },
  "invocation": {
    "kind": "command",
    "text": "touch -t 202001010101.00 .; complete -C 'cat fresh'; touch fresh.txt; touch -t 202001010101.00 .; complete -C 'cat fresh'"
  },
  "timeout_seconds": 15,
  "expected": {
    "stdout": {"contains": ["fresh.txt"]},
    "stderr": {"equals": ""},
    "exit_code": 0
  }
}
