{
  "id": "J03-cd-and-cdpath",
  "uc": [
    "J03"
  ],
  "mode": "batch",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_J03-cd-and-cdpath> ",
      "CDPATH": "parent"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "work/parent/nested/entry.txt",
        "content": "x"
      }
    ]
  },
  "invocation": {
    "kind": "command",
    "text": "cd nested; pwd > result.txt; cat result.txt"
  },
  "expected": {
    "stdout": {
      "contains": [
        "nested"
      ]
    },
    "exit_code": 0,
    "side_effects": {
      "files": [
        {
          "path": "result.txt",
          "exists": true,
          "contains": [
            "parent/nested"
          ]
        }
      ]
    }
  },
  "expected_failure": {
    "reason": "WP-C06 owns completion context for cd and CDPATH."
  }
}
