{
  "id": "J03-cd-and-cdpath",
  "uc": ["J03"],
  "mode": "pty",
  "input_delay_seconds": 0.1,
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_J03-cd-and-cdpath> ",
      "CDPATH": "parent"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "work/parent/nested/entry.txt",
        "content": "J03_CDPATH_COMPLETION_OK\n"
      }
    ]
  },
  "steps": [
    {"type": "keys", "text": "cd ne"},
    {"type": "key", "key": "Tab"},
    {"type": "key", "key": "Tab"},
    {"type": "keys", "text": "; cat entry.txt"},
    {"type": "key", "key": "Enter"},
    {"type": "wait", "contains": "J03_CDPATH_COMPLETION_OK"},
    {"type": "keys", "text": "exit"},
    {"type": "key", "key": "Enter"},
    {"type": "wait_exit"}
  ],
  "expected": {
    "stream": {
      "contains": ["J03_CDPATH_COMPLETION_OK"]
    },
    "exit_code": 0
  }
}
