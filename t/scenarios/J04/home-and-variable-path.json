{
  "id": "J04-home-and-variable-path",
  "uc": [
    "J04"
  ],
  "mode": "pty",
  "input_delay_seconds": 0.1,
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_J04-home-and-variable-path> ",
      "TARGET": "../home/target",
      "NOTE": "../home/target/variable-note.txt"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "home/target/variable-note.txt",
        "content": "J04_VARIABLE_PATH_OK\n"
      },
      {
        "path": "home/target/home-note.txt",
        "content": "J04_HOME_PATH_OK\n"
      }
    ]
  },
  "steps": [
    {
      "type": "keys",
      "text": "(cat $TARGET/variable-)"
    },
    {
      "type": "key",
      "key": "C-b"
    },
    {
      "type": "key",
      "key": "Tab"
    },
    {
      "type": "wait_screen",
      "contains": "$TARGET/variable-note.txt"
    },
    {
      "type": "key",
      "key": "C-a"
    },
    {
      "type": "key",
      "key": "C-k"
    },
    {
      "type": "keys",
      "text": "(cat $NOTE)"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "J04_VARIABLE_PATH_OK"
    },
    {
      "type": "keys",
      "text": "cat ~/target/home-"
    },
    {
      "type": "key",
      "key": "Tab"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "J04_HOME_PATH_OK"
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit"
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "J04_VARIABLE_PATH_OK",
        "J04_HOME_PATH_OK"
      ]
    },
    "exit_code": 0
  }
}
