{
  "id": "J07-ssh-hostname",
  "uc": [
    "J07"
  ],
  "mode": "batch",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_J07-ssh-hostname> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "home/.ssh/config",
        "content": "Host scenario-build-host *.example !private\n  HostName build.invalid\n"
      },
      {
        "path": "home/.ssh/known_hosts",
        "content": "scenario-known-host ssh-ed25519 placeholder-key\n|1|scenario-hashed|checksum ssh-ed25519 placeholder-key\n"
      }
    ]
  },
  "invocation": {
    "kind": "command",
    "text": "complete -C \"ssh \""
  },
  "expected": {
    "stdout": {
      "contains": [
        "scenario-build-host",
        "scenario-known-host"
      ],
      "excludes": [
        "scenario-hashed"
      ]
    },
    "exit_code": 0
  }
}
