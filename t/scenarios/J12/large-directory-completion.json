{
  "id": "J12-large-directory-completion",
  "uc": ["J12"],
  "mode": "batch",
  "environment": {
    "home": "home",
    "cwd": "work",
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "dumb"
    }
  },
  "preconditions": {
    "file_sets": [
      {
        "directory": "work",
        "prefix": "entry_",
        "suffix": ".txt",
        "count": 20000,
        "content": "J12_FILE_SET_MARKER\n"
      }
    ]
  },
  "invocation": {
    "kind": "command",
    "text": "complete -C 'cat ./entry_'"
  },
  "timeout_seconds": 60,
  "expected": {
    "stdout": {"contains": ["entry_19999.txt"]},
    "stderr": {"equals": ""},
    "exit_code": 0
  }
}
