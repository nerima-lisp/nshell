{
  "id": "J12-twenty-thousand-entry-directory",
  "uc": [
    "J12"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_J12-twenty-thousand-entry-directory> ",
      "SCENARIO_VALUE": "J12_COMPLETION_READY"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "steps": [
    {
      "type": "keys",
      "text": "/bin/bash -c 'mkdir -p many; for ((i=1;i<=20000;i++)); do : > many/item-$i; done'; cd many; complete -C \"cat item-19999\"; echo \"$SCENARIO_VALUE\""
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "J12_COMPLETION_READY",
      "timeout_seconds": 30
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "J12_COMPLETION_READY"
      ]
    },
    "exit_code": 0
  }
}
