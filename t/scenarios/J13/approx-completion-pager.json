{
  "id": "J13-approx-completion-pager",
  "uc": [
    "J13"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_J13-approx-completion-pager> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 6
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "home/.config/nshell/init.lisp",
        "content": "complete -c scenario-pick -a \"one two three four five six seven eight\"\n"
      }
    ]
  },
  "steps": [
    {
      "type": "keys",
      "text": "true; echo J13_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "J13_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "scenario-pick "
    },
    {
      "type": "key",
      "key": "Tab"
    },
    {
      "type": "wait",
      "contains": "one",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "Down"
    },
    {
      "type": "key",
      "key": "C-c"
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "one"
      ]
    },
    "exit_code": 0
  },
  "load_config": true
}
