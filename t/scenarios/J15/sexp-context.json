{
  "id": "J15-sexp-context",
  "uc": ["J15"],
  "mode": "pty",
  "input_delay_seconds": 0.1,
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_J15-sexp-context> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "steps": [
    {"type": "keys", "text": "(progn (git st"},
    {"type": "key", "key": "Tab"},
    {"type": "wait", "contains": "status"},
    {"type": "key", "key": "C-c"},
    {"type": "keys", "text": "exit"},
    {"type": "key", "key": "Enter"},
    {"type": "wait_exit"}
  ],
  "expected": {
    "stream": {
      "contains": ["status"]
    },
    "exit_code": 0
  }
}
