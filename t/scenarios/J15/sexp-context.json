{
  "id": "J15-sexp-context",
  "uc": ["J15"],
  "mode": "pty",
  "input_delay_seconds": 0.12,
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_J15-sexp-context> ",
      "NSHELL_READER": "sexp"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "steps": [
    {"type": "keys", "text": "(progn (git st"},
    {"type": "key", "key": "Tab"},
    {"type": "wait", "contains": "status"},
    {"type": "key", "key": "C-c"},
    {"type": "keys", "text": "exit"},
    {"type": "key", "key": "Enter"},
    {"type": "wait_exit"}
  ],
  "expected": {
    "stream": {
      "contains": ["status"]
    },
    "exit_code": 0
  },
  "expected_failure": {
    "reason": "WP-E03: the reader REPL creates a local shell context and returns only status; the exit builtin stops that context, but the stop state is not propagated to the REPL loop (src/presentation/repl-execution.lisp:33; src/application/builtin-commands.lisp:174; t/scenarios/J15/sexp-context.json:25)."
  }
}
