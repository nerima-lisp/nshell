{
  "id": "J16-approx-user-defined-completion",
  "uc": [
    "J16"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_J16-approx-user-defined-completion> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "home/.config/nshell/init.lisp",
        "content": "complete -c local-tool -a \"north south\"\n"
      }
    ]
  },
  "steps": [
    {
      "type": "keys",
      "text": "true; echo J16_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "J16_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "local-tool n"
    },
    {
      "type": "key",
      "key": "Tab"
    },
    {
      "type": "key",
      "key": "C-c"
    },
    {
      "type": "keys",
      "text": "echo J16_AFTER_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "J16_AFTER_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "north"
      ]
    },
    "exit_code": 0
  },
  "load_config": true,
  "expected_failure": {
    "reason": "Plan FR-024 defers user-defined completion to P6; no implementation WP is assigned."
  }
}
