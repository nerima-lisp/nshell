{
  "id": "J18-approx-completion-candidate-preview",
  "uc": [
    "J18"
  ],
  "mode": "pty",
  "input_delay_seconds": 0.5,
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_J18-approx-completion-candidate-preview> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "work/preview-file.txt",
        "content": "J18_FILE_PREVIEW_CONTENT"
      },
      {
        "path": "home/.config/nshell/init.lisp",
        "content": "complete -c preview-tool -a preview-file.txt\n"
      }
    ]
  },
  "steps": [
    {
      "type": "keys",
      "text": "(true)"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": "(printf \"J18_%d\" ,(+ 1 1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "J18_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "preview-tool p"
    },
    {
      "type": "key",
      "key": "Tab"
    },
    {
      "type": "key",
      "key": "C-c"
    },
    {
      "type": "wait_screen",
      "excludes": [
        "J18_FILE_PREVIEW_CONTENT"
      ],
      "timeout_seconds": 5
    },
    {
      "type": "keys",
      "text": "(printf \"J18_AFTER_%d\" ,(+ 1 1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "J18_AFTER_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "preview-file.txt",
        "J18_FILE_PREVIEW_CONTENT"
      ]
    },
    "exit_code": 0
  },
  "load_config": true
}
