{
  "id": "J18-approx-completion-candidate-preview",
  "uc": [
    "J18"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_J18-approx-completion-candidate-preview> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "work/preview-file.txt",
        "content": "J18_FILE_PREVIEW_CONTENT"
      },
      {
        "path": "home/.config/nshell/init.lisp",
        "content": "complete -c preview-tool -a preview-file.txt\n"
      }
    ]
  },
  "steps": [
    {
      "type": "keys",
      "text": "true; echo J18_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "J18_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "preview-tool p"
    },
    {
      "type": "key",
      "key": "Tab"
    },
    {
      "type": "wait",
      "contains": "preview-file.txt",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "C-c"
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "preview-file.txt",
        "J18_FILE_PREVIEW_CONTENT"
      ]
    },
    "exit_code": 0
  },
  "load_config": true
}
