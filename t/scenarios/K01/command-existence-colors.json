{
  "id": "K01-command-existence-colors",
  "uc": [
    "K01"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_K01-command-existence-colors> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "steps": [
    {
      "type": "keys",
      "text": "nshell-command-that-does-not-exist"
    },
    {
      "type": "key",
      "key": "C-c"
    },
    {
      "type": "key",
      "key": "C-d"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "\u001b[1;38;5;"
      ]
    },
    "exit_code": 0
  }
}
