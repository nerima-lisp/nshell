{
  "id": "K04-unbalanced-parenthesis-diagnostic",
  "uc": [
    "K04"
  ],
  "mode": "pty",
  "input_delay_seconds": 0.12,
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "K04_READY ",
      "NSHELL_RIGHT_PROMPT": "{time}"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "steps": [
    {
      "type": "keys",
      "text": "(touch K04_SHOULD_NOT_EXIST"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "key",
      "key": "C-c"
    },
    {
      "type": "keys",
      "text": "echo K04_AFTER_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "K04_AFTER_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "> "
      ]
    },
    "exit_code": 0,
    "side_effects": {
      "files": [
        {
          "path": "K04_SHOULD_NOT_EXIST",
          "exists": false
        }
      ]
    }
  },
  "expected_failure": {
    "reason": "WP-E05 owns diagnostics for unbalanced parentheses."
  }
}
