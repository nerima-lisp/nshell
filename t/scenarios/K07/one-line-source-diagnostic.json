{
  "id": "K07-one-line-source-diagnostic",
  "uc": [
    "K07"
  ],
  "mode": "batch",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "NSHELL_READER": "sexp",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_K07-one-line-source-diagnostic> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "invocation": {
    "kind": "script",
    "path": "scenario.nsh",
    "text": "(\necho K07_AFTER_ERROR"
  },
  "expected": {
    "stderr": {
      "contains": [
        "scenario.nsh:",
        "syntax error"
      ]
    },
    "exit_code": 1
  },
  "expected_failure": {
    "reason": "WP-L07 owns the unimplemented CONTEXT-SHELL-FUNCTION-REGISTRY interface required to load this script."
  }
}
