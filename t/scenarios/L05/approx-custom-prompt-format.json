{
  "id": "L05-approx-custom-prompt-format",
  "uc": [
    "L05"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_L05-approx-custom-prompt-format> ",
      "TEST_PROMPT_FORMAT": "CUSTOM_{path}",
      "SCENARIO_VALUE": "L05_CUSTOM_PROMPT"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "steps": [
    {
      "type": "keys",
      "text": "prompt left \"$TEST_PROMPT_FORMAT\""
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "CUSTOM_",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "echo \"$SCENARIO_VALUE\""
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "CUSTOM_",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "CUSTOM_",
        "L05_CUSTOM_PROMPT"
      ]
    },
    "exit_code": 0
  }
}
