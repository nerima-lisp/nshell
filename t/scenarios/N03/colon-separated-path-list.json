{
  "id": "N03-colon-separated-path-list",
  "uc": [
    "N03"
  ],
  "mode": "batch",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_N03-colon-separated-path-list> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "invocation": {
    "kind": "command",
    "text": "set -x PATH a $PATH; env"
  },
  "expected": {
    "stdout": {
      "contains": [
        "PATH=a:",
        ":/usr/bin:/bin"
      ]
    },
    "exit_code": 0
  }
}
