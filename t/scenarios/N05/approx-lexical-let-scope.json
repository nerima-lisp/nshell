{
  "id": "N05-approx-lexical-let-scope",
  "uc": [
    "N05"
  ],
  "mode": "batch",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "SCENARIO_N05-approx-lexical-let-scope> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "invocation": {
    "kind": "script",
    "path": "scenario.nsh",
    "text": "(set lexical_scope \"outer\")\n(defun scope_probe () (let ((lexical_scope \"inner\")) (echo $lexical_scope)))\n(scope_probe)\n(echo $lexical_scope)\n"
  },
  "expected": {
    "stdout": {
      "contains": [
        "inner",
        "outer"
      ]
    },
    "exit_code": 0
  }
}
