{
  "id": "O07-interactive-command-failed-restart",
  "uc": [
    "O07"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "O07> ",
      "SCENARIO_MARKER": "O07_RESTART_CONTINUED_2"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "steps": [
    {
      "type": "keys",
      "text": "(defun o07_fail () (^cat missing-o07-file))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": "(o07_fail)"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "Ignore and continue",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "1"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": "echo $SCENARIO_MARKER"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "O07_RESTART_CONTINUED_2",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "C-d"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "Ignore and continue",
        "O07_RESTART_CONTINUED_2"
      ]
    },
    "exit_code": 0
  }
}
