{
  "id": "O07-interactive-command-failed-restart",
  "uc": [
    "O07"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "O07> ",
      "SCENARIO_MARKER": "O07_RESTART_CONTINUED_OK"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "steps": [
    {
      "type": "keys",
      "text": "cat missing-o07-file"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": "1"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": "echo O07_RESTART_CONTINUED_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "O07_RESTART_CONTINUED_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "ignore and continue",
        "O07_RESTART_CONTINUED_2"
      ]
    },
    "exit_code": 0
  },
  "expected_failure": {
    "reason": "WP-L04 owns interactive command-failed restart handling."
  }
}
