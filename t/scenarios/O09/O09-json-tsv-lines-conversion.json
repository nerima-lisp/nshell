{
  "id": "O09-json-tsv-lines-conversion",
  "uc": [
    "O09"
  ],
  "mode": "batch",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "dumb",
      "NSHELL_READER": "sexp"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "invocation": {
    "kind": "script",
    "path": "scenario.nsh",
    "text": "(echo ,(to-json (from-json \"{\\\"name\\\":\\\"Ada\\\"}\")))\n(echo ,(to-tsv (from-tsv (concatenate (quote string) \"name\" (string #\\Tab) \"Ada\" (string #\\Newline)))))\n(echo ,(from-lines (to-lines (concatenate (quote string) \"first\" (string #\\Newline) \"second\" (string #\\Newline)))))\n"
  },
  "expected": {
    "stdout": {
      "contains": [
        "Ada",
        "name",
        "first",
        "second"
      ]
    },
    "exit_code": 0
  }
}
