{
  "id": "O15-asdf-library-load",
  "uc": [
    "O15"
  ],
  "mode": "batch",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "dumb"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "work/scenario-helper.asd",
        "content": "(asdf:defsystem \"scenario-helper\" :serial t :components ((:file \"scenario-helper\")))\n"
      },
      {
        "path": "work/scenario-helper.lisp",
        "content": "(defpackage #:scenario-helper (:use #:cl))\n(in-package #:scenario-helper)\n(defun greeting () \"O15_ASDF_OK\")\n"
      }
    ]
  },
  "invocation": {
    "kind": "script",
    "path": "scenario.nsh",
    "text": "(eval-when (:EXECUTE) (pushnew (truename \".\") asdf:*central-registry* :TEST #'equal))\n(asdf:load-system \"scenario-helper\")\n(format t \"~a~%\" (scenario-helper:greeting))\n"
  },
  "expected": {
    "stdout": {
      "contains": [
        "O15_ASDF_OK"
      ]
    },
    "exit_code": 0
  }
}
