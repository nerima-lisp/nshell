{
  "id": "O18-alias-eval-and-string-execution",
  "uc": [
    "O18"
  ],
  "mode": "batch",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "dumb",
      "NSHELL_READER": "sexp"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "invocation": {
    "kind": "script",
    "path": "scenario.nsh",
    "text": "alias o18_alias 'echo \"O18_ALIAS_OK\"'\no18_alias\n(eval \"echo O18_EVAL_OK\")\n"
  },
  "expected": {
    "stdout": {
      "contains": [
        "O18_ALIAS_OK",
        "O18_EVAL_OK"
      ]
    },
    "exit_code": 0
  },
  "expected_failure": {
    "reason": "WP-O18fix: the NSHELL_READER=sexp command-stage resolver does not expand aliases before resolving shell functions, builtins, and PATH commands. Integrating alias expansion into reader-backed command planning remains a separate execution task."
  }
}
