{
  "id": "P01-xdg-init-file",
  "uc": [
    "P01"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "P01> ",
      "SCENARIO_MARKER": "P01_SYNC_17"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "home/.config/nshell/init.lisp",
        "content": "(format t \"P01_XDG_INIT_OK~%\")\n"
      }
    ]
  },
  "expected": {
    "stream": {
      "contains": [
        "P01_XDG_INIT_OK",
        "42"
      ]
    },
    "exit_code": 0
  },
  "load_config": true,
  "input_delay_seconds": 0.12,
  "steps": [
    {
      "type": "keys",
      "text": "(format t \"~d~%\" (* 6 7))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": "echo $SCENARIO_MARKER"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "P01_SYNC_17",
      "timeout_seconds": 10
    },
    {
      "type": "key",
      "key": "C-d"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ]
}
