{
  "id": "P11-continue-after-config-error",
  "uc": [
    "P11"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "P11> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "home/.config/nshell/init.lisp",
        "content": "(format t \"P11_CONFIG_LOADED~%\")\n(nshell-p11-missing-command)\n"
      }
    ]
  },
  "expected": {
    "stream": {
      "contains": [
        "P11_CONFIG_LOADED",
        "42"
      ]
    },
    "exit_code": 0
  },
  "load_config": true,
  "input_delay_seconds": 0.12,
  "steps": [
    {
      "type": "keys",
      "text": "(format t \"~d~%\" (* 6 7))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": "echo P11_SYNC_$((9+8))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "P11_SYNC_17",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ]
}
