    "path": "scenario.nsh",
    "text": ")\n"
  },
  "expected": {
    "exit_code": 2,
    "stdout": {
      "excludes": [
        "#S(",
        "Backtrace",
        "SB-DEBUG"
      ]
    },
    "stderr": {
      "excludes": [
        "#S(",
        "Backtrace",
        "SB-DEBUG"
      ]
    }
  }
