{
  "id": "Q02-bounded-recursion-recovery",
  "uc": [
    "Q02"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "Q02> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "expected": {
    "stream": {
      "contains": [
        "recursion",
        "Q02_AFTER_2"
      ],
      "excludes": [
        "Backtrace",
        "#S("
      ]
    },
    "exit_code": 0
  },
  "steps": [
    {
      "type": "keys",
      "text": "(define-shell-function q02_recurse () (q02_recurse))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": "q02_recurse"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "keys",
      "text": "echo Q02_AFTER_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "Q02_AFTER_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ]
}
