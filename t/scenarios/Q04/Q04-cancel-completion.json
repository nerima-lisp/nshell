{
  "id": "Q04-cancel-completion",
  "uc": [
    "Q04"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "Q04> ",
      "SCENARIO_MARKER": "Q04_AFTER_CTRL_C_OK",
      "SCENARIO_PRIME": "Q04_READY"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": []
  },
  "steps": [
    {
      "type": "keys",
      "text": "printf Q04_READY_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "Q04_READY_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "ec"
    },
    {
      "type": "key",
      "key": "Tab"
    },
    {
      "type": "key",
      "key": "C-c"
    },
    {
      "type": "keys",
      "text": "printf Q04_AFTER_CTRL_C_$((1+1))"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "Q04_AFTER_CTRL_C_2",
      "timeout_seconds": 10
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit",
      "timeout_seconds": 10
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "ho",
        "Q04_AFTER_CTRL_C_2"
      ]
    },
    "exit_code": 0
  }
}
