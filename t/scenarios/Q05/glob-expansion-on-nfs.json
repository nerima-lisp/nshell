{
  "id": "Q05-nfs-glob-expansion",
  "uc": ["Q05"],
  "mode": "pty",
  "timeout_seconds": 60,
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "Q05_GLOB_PROMPT> "
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {"columns": 120, "rows": 24}
  },
  "preconditions": {"files": []},
  "steps": [
    {"type": "keys", "text": "echo /mnt/q05/glob/glob-probe-*"},
    {"type": "key", "key": "Enter"},
    {"type": "wait", "contains": "/mnt/q05/glob/glob-probe-a", "timeout_seconds": 60},
    {"type": "keys", "text": "printf 'Q05_%s\\n' OK"},
    {"type": "key", "key": "Enter"},
    {"type": "wait", "contains": "Q05_OK", "timeout_seconds": 60},
    {"type": "keys", "text": "exit"},
    {"type": "key", "key": "Enter"},
    {"type": "wait_exit", "timeout_seconds": 10}
  ],
  "expected": {
    "stream": {"contains": ["/mnt/q05/glob/glob-probe-a", "/mnt/q05/glob/glob-probe-b", "Q05_OK"]},
    "exit_code": 0
  }
}
