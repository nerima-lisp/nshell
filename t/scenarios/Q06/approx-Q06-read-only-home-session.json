{
  "id": "Q06-read-only-home-session",
  "uc": [
    "Q06"
  ],
  "mode": "pty",
  "environment": {
    "variables": {
      "PATH": "/usr/bin:/bin",
      "TERM": "xterm-256color",
      "NSHELL_PROMPT": "Q06_READONLY_PROMPT> ",
      "Q06_MARKER": "Q06_READONLY_SESSION_OK"
    },
    "home": "home",
    "cwd": "work",
    "terminal_size": {
      "columns": 80,
      "rows": 24
    }
  },
  "preconditions": {
    "files": [
      {
        "path": "home/.nshellrc",
        "content": ""
      }
    ],
    "read_only_directories": [
      "home",
      "home/.config",
      "home/.cache",
      "home/.local/share",
      "home/.local/state"
    ]
  },
  "load_config": true,
  "steps": [
    {
      "type": "keys",
      "text": "echo \"$Q06_MARKER\""
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "Q06_READONLY_SESSION_OK"
    },
    {
      "type": "key",
      "key": "C-d"
    },
    {
      "type": "wait_exit"
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "Q06_READONLY_SESSION_OK"
      ]
    },
    "exit_code": 0
  }
}
