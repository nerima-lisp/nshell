{
  "id": "Q07-history-write-failure-on-bounded-filesystem",
  "uc": [
    "Q07"
  ],
  "mode": "pty",
  "timeout_seconds": 45,
  "requires_bounded_tmpdir": true,
  "environment": {
    "variables": {
      "NSHELL_PROMPT": "Q07_PROMPT",
      "Q07_MARKER": "Q07_AFTER_FULL_FILESYSTEM",
      "Q07_FILL_MARKER": "Q07_FILESYSTEM_FILLED"
    }
  },
  "steps": [
    {
      "type": "keys",
      "text": " dd if=/dev/zero of=.q07-full bs=4096 count=4096; echo $Q07_FILL_MARKER"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "Q07_FILESYSTEM_FILLED"
    },
    {
      "type": "paste",
      "text": "true #"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "nshell: history: unable to append to"
    },
    {
      "type": "keys",
      "text": "echo $Q07_MARKER"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "contains": "Q07_AFTER_FULL_FILESYSTEM"
    },
    {
      "type": "keys",
      "text": "exit"
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait_exit"
    }
  ],
  "expected": {
    "stream": {
      "contains": [
        "No space left on device",
        "Q07_FILESYSTEM_FILLED",
        "nshell: history: unable to append to",
        "Q07_AFTER_FULL_FILESYSTEM"
      ],
      "excludes": [
        "Backtrace",
        "fatal error encountered"
      ]
    },
    "exit_code": 0,
    "side_effects": {
      "history": {
        "path": ".local/share/nshell/history",
        "exists": false
      }
    }
  }
}
